# =============================================================================
# Qwen 3.8 27B Optimized Modelfile (65k Context for 24GB VRAM)
# =============================================================================
#
# This Modelfile builds an optimized expert model tuned for 24GB VRAM GPUs
# (RTX 3090 / 4090 / 5090) with a 65,536 token context window and custom sampling.
#
# Prerequisites:
#   ollama pull qwen3.8:27b
#
# Build:
#   ollama create qwen3.8opt:latest -f Modelfile.qwen38opt
#
# Verify:
#   ollama show qwen3.8opt:latest --parameters
# =============================================================================

FROM qwen3.8:27b

# Context and Batch Optimization (65k context fits in 24GB VRAM)
PARAMETER num_ctx 65536
PARAMETER num_batch 2048
PARAMETER num_gpu 999

# Reasoning and Sampling Optimization
PARAMETER temperature 1.0
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0.0
PARAMETER repeat_penalty 1.0
PARAMETER presence_penalty 0.0
PARAMETER draft_num_predict 4
